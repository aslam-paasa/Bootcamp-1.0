# -----------------------------------------------
# .gitignore — files Git should NEVER track
# -----------------------------------------------

# Environment variables — MOST IMPORTANT
# Never push this to GitHub — it contains your secrets!
.env

# Node modules — these are installed from package.json
# No need to push them — just run "npm install" after cloning
node_modules/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log