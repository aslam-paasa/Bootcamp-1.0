# Assignment 25 — Nodemailer Environment Variables
# ---------------------------------------------------
# Sign up at https://mailtrap.io (free)
# Go to: Email Testing → Inboxes → SMTP Settings
# Copy your username and password below

PORT=3000

# Mailtrap credentials (for development/testing)
MAILTRAP_USER=your_mailtrap_username_here
MAILTRAP_PASS=your_mailtrap_password_here

# For Gmail (alternative — needs App Password):
# GMAIL_USER=your@gmail.com
# GMAIL_PASS=your_16_char_app_password
